<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.example.duallens3dcamera.ui.RotatingButton
            android:id="@+id/btnSettings"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="@android:color/white"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="false"
            android:text="SETTINGS"
            android:textColor="@android:color/white"
            app:backgroundTint="@android:color/black"
            app:cornerRadius="0dp"/>

        <com.example.duallens3dcamera.ui.RotatingButton
            android:id="@+id/btnEis"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="false"
            android:text="EIS"
            android:textColor="@android:color/white"
            app:backgroundTint="@android:color/black"
            app:cornerRadius="0dp"/>

        <!-- Live preview mode: 2D / 3D side-by-side / ANA (red-cyan anaglyph) -->
        <com.example.duallens3dcamera.ui.RotatingButton
            android:id="@+id/btnPreview3d"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="false"
            android:text="2D"
            android:textColor="@android:color/white"
            app:backgroundTint="@android:color/black"
            app:cornerRadius="0dp"/>

        <!-- Keep id btnFormat for the photo format toggle -->
        <com.example.duallens3dcamera.ui.RotatingButton
            android:id="@+id/btnFormat"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="false"
            android:text="JPG"
            android:textColor="@android:color/white"
            app:backgroundTint="@android:color/black"
            app:cornerRadius="0dp"/>

        <!-- Pro: manual ISO / shutter (same on both lenses) -->
        <com.example.duallens3dcamera.ui.RotatingButton
            android:id="@+id/btnPro"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:textAllCaps="false"
            android:text="PRO"
            android:textColor="@android:color/white"
            app:backgroundTint="@android:color/black"
            app:cornerRadius="0dp"/>
    </LinearLayout>

    <!-- Preview (TextureView must NOT have android:background) -->
    <TextureView
        android:id="@+id/textureView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Live 3D preview frames (side-by-side or anaglyph), shown over the normal preview -->
    <ImageView
        android:id="@+id/preview3d"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:contentDescription="Live 3D preview"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/textureView"
        app:layout_constraintBottom_toBottomOf="@id/textureView"
        app:layout_constraintStart_toStartOf="@id/textureView"
        app:layout_constraintEnd_toEndOf="@id/textureView"/>

    <!-- Grid / spirit level overlay (viewfinder only, never in photos) -->
    <com.example.duallens3dcamera.ui.LevelGridOverlay
        android:id="@+id/levelGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/textureView"
        app:layout_constraintBottom_toBottomOf="@id/textureView"
        app:layout_constraintStart_toStartOf="@id/textureView"
        app:layout_constraintEnd_toEndOf="@id/textureView"/>

    <!-- Self-timer countdown -->
    <TextView
        android:id="@+id/countdownText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shadowColor="@android:color/black"
        android:shadowRadius="8"
        android:textColor="@android:color/white"
        android:textSize="120sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/textureView"
        app:layout_constraintBottom_toBottomOf="@id/textureView"
        app:layout_constraintStart_toStartOf="@id/textureView"
        app:layout_constraintEnd_toEndOf="@id/textureView"/>

    <!-- Time-lapse progress (tap to brighten the screen while it runs) -->
    <TextView
        android:id="@+id/lapseStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="#B0000000"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/textureView"
        app:layout_constraintStart_toStartOf="@id/textureView"
        app:layout_constraintEnd_toEndOf="@id/textureView"/>

    <!-- Pro panel: ISO and shutter choices (built in code) -->
    <LinearLayout
        android:id="@+id/proPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#C0000000"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/textureView"
        app:layout_constraintStart_toStartOf="@id/textureView"
        app:layout_constraintEnd_toEndOf="@id/textureView"/>

    <!-- 1x/2x zoom toggle (overlayed on preview) -->
    <com.example.duallens3dcamera.ui.RotatingButton
        android:id="@+id/btnZoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.85"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="1x"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        app:backgroundTint="@android:color/black"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/proPanel"
        app:layout_constraintEnd_toEndOf="@id/textureView"/>

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/buttonPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/textureView"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tools row: torch, self-timer, grid/level, time-lapse -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <com.example.duallens3dcamera.ui.RotatingButton
                android:id="@+id/btnTorch"
                app:icon="@drawable/ic_flash"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="22dp"
                app:iconTint="@android:color/white"
                android:letterSpacing="0"
                android:textSize="12sp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:maxLines="1"
                android:textAllCaps="false"
                android:text="Torch OFF"
                android:textColor="@android:color/white"
                app:backgroundTint="@android:color/black"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:cornerRadius="0dp"/>

            <com.example.duallens3dcamera.ui.RotatingButton
                android:id="@+id/btnTimer"
                app:icon="@drawable/ic_timer"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="22dp"
                app:iconTint="@android:color/white"
                android:letterSpacing="0"
                android:textSize="12sp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:maxLines="1"
                android:textAllCaps="false"
                android:text="Timer OFF"
                android:textColor="@android:color/white"
                app:backgroundTint="@android:color/black"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:cornerRadius="0dp"/>

            <com.example.duallens3dcamera.ui.RotatingButton
                android:id="@+id/btnGrid"
                app:icon="@drawable/ic_grid"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="22dp"
                app:iconTint="@android:color/white"
                android:letterSpacing="0"
                android:textSize="12sp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:maxLines="1"
                android:textAllCaps="false"
                android:text="Grid off"
                android:textColor="@android:color/white"
                app:backgroundTint="@android:color/black"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:cornerRadius="0dp"/>

            <com.example.duallens3dcamera.ui.RotatingButton
                android:id="@+id/btnLapse"
                app:icon="@drawable/ic_timelapse"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="22dp"
                app:iconTint="@android:color/white"
                android:letterSpacing="0"
                android:textSize="12sp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:maxLines="1"
                android:textAllCaps="false"
                android:text="T-lapse"
                android:textColor="@android:color/white"
                app:backgroundTint="@android:color/black"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                app:cornerRadius="0dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.4"
            android:orientation="horizontal">

            <com.example.duallens3dcamera.ui.RotatingButton
                android:id="@+id/btnPhoto"
                app:icon="@drawable/ic_photo_camera"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="30dp"
                app:iconTint="@android:color/white"
                android:textSize="17sp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:text="PHOTO"
                android:textColor="@android:color/white"
                app:backgroundTint="@android:color/holo_green_dark"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="0dp"/>

            <com.example.duallens3dcamera.ui.RotatingButton
                android:id="@+id/btnRecord"
                app:icon="@drawable/ic_videocam"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="30dp"
                app:iconTint="@android:color/white"
                android:textSize="17sp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:text="RECORD"
                android:textColor="@android:color/white"
                app:backgroundTint="@android:color/holo_red_dark"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="0dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
